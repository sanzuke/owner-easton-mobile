# Salin file ini menjadi .env dan sesuaikan sebelum build (berkas .env wajib ada: terdaftar sebagai asset di pubspec.yaml).
# Base URL Laravel API (lihat docs/96_perencanaan_mobile_app_owner.md §3, prefix /api/v1).
# Pilih SATU baris, hapus tanda # di depannya.

# Emulator Android -> Laravel di komputer lokal (php artisan serve --port=8000)
API_BASE_URL=http://10.0.2.2:8000/api/v1

# HP fisik -> Laravel di komputer lokal (ganti dengan IP LAN komputer, server dijalankan dengan --host=0.0.0.0)
# API_BASE_URL=http://192.168.1.10:8000/api/v1

# Staging Laravel (bms2). PERHATIAN: bms2 berbagi database bms_dev_2 dengan bms1 (staging CI3), jadi
# akun dan data yang dipakai uji adalah data yang sama dengan bms1. Push (FCM) mati sampai PUSH_ENABLED=true di server.
# API_BASE_URL=https://bms2.eprjatinangor.com/api/v1
